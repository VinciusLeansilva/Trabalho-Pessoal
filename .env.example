# =============================================
# EduMatrix - Variáveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha os valores

# ----- Banco de Dados -----
DATABASE_URL="postgresql://edumatrix:edumatrix_pass@localhost:3000/edumatrix_db"

# ----- NextAuth -----
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"
NEXTAUTH_URL="http://localhost:3000"

# ----- Upload de Arquivos -----
# Local (desenvolvimento)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=50

# AWS S3 (produção - deixar em branco para usar local)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_BUCKET_NAME=

# ----- IA Pedagógica (Fase 18) -----
# Descomente e preencha quando implementar IA
# OPENAI_API_KEY=
# GOOGLE_GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# ----- App -----
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="EduMatrix"
